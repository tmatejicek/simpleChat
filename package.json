{
  "name": "simple-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Small authenticated WebSocket chat relay",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "check": "node --check app.js && node --check eslint.config.js && for file in scripts/*.js src/*.js test/*.js; do node --check \"$file\"; done",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 --test",
    "validate-config": "node scripts/validate-config.js",
    "verify": "npm run check && npm run lint && npm run coverage",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "sanitize-html": "^2.13.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1"
  }
}
