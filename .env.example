# Required: at least 32 base64url-safe characters.
JWT_SECRET=

# The application listens only on loopback by default.
HOST=127.0.0.1
PORT=8080
WS_PATH=/

# Optional JWT constraints. Configure these when the token issuer supports them.
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=simple-chat

# Comma-separated browser origins. Empty means Origin filtering is disabled.
# ALLOWED_ORIGINS=https://chat.example.com

# Conservative WebSocket defaults.
MAX_PAYLOAD_BYTES=16384
MAX_MESSAGE_CONTENT_LENGTH=4096
MAX_CONNECTIONS_PER_USER=5
CONNECTION_RATE_LIMIT=30
CONNECTION_RATE_WINDOW_MS=60000
MESSAGE_RATE_LIMIT=100
MESSAGE_RATE_WINDOW_MS=60000
HEARTBEAT_INTERVAL_MS=30000
